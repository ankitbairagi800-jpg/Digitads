{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "digitalads",
  "compatibility_date": "2026-05-18",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "out"
  },
  "build": {
    "command": "npm run build"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "digitalads-db",
      "database_id": "280a8260-0c41-4a5c-b481-da4203da8526"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "digitalads-storage"
    }
  ]
}
